.PHONY: build test benchmark fmt clean

build:
	go build ./...
	cd pgxq && go build ./...
	cd examples && go build ./...

test:
	go test ./...
	cd pgxq && go test ./...
	cd tests && go test ./...
	cd examples && go test ./...

benchmark:
	cd tests && go test -run '^$$' -bench . ./...

fmt:
	gofmt -w workq.go pgxq/*.go tests/*.go examples/*/*.go

clean:
	go clean ./...
	cd pgxq && go clean ./...
	cd tests && go clean ./...
	cd examples && go clean ./...
